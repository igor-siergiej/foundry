        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (method, route) (count_over_time({container=~\"apps-jewellerycatalogueapi-.*\"} |~ \" - [0-9]{3} [0-9]+ms\\\"\" | json | line_format \"{{.message}}\" | regexp \"^(?P<method>[A-Z]+) (?P<path>\\\\S+) - (?P<status>\\\\d{3}) (?P<duration>\\\\d+)ms$\" | path!=\"/api/health\" | label_format route=`{{ regexReplaceAll \"[0-9a-f]{24}\" .path \":id\" }}` [$__range])))",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ],
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "renameByName": {
              "Last *": "requests"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "requests",
            "desc": true
          }
        ]
      },
      "description": "Mongo ObjectIds in the path collapsed to :id."

  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests (excl. health checks)",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=~\"apps-jewellerycatalogueapi-.*\"} |~ \" - [0-9]{3} [0-9]+ms\\\"\" | json | line_format \"{{.message}}\" | regexp \"^(?P<method>[A-Z]+) (?P<path>\\\\S+) - (?P<status>\\\\d{3}) (?P<duration>\\\\d+)ms$\" | path!=\"/api/health\" [$__range])) or vector(0)",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "description": "Parsed from the requestLogger completion line \"METHOD /url - STATUS Nms\". /api/health (Gatus, 1/min) excluded."
    },

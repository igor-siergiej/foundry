      "targets": [
        {"refId": "A", "expr": "count(sum by (ua) (count_over_time({container=~\"apps-jewellerycatalogueweb-.*\"} |= \"HTTP/\" != \"Gatus/1.0\" | pattern `<_> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referer>\" \"<ua>\" \"<xff>\"` | status=~\"[0-9]{3}\" | ua=~\"Mozilla.*\" | ua!~\".*(HeadlessChrome|[Bb]ot|[Ss]can|[Ss]pider|[Cc]rawl|Palo Alto|Censys).*\" [$__range])))", "instant": true, "queryType": "instant"}

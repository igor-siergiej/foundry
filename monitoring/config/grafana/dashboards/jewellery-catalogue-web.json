    {
      "id": 1,
      "type": "stat",
      "title": "App loads (/config.json fetches)",
      "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(count_over_time({container=~\"apps-jewellerycatalogueweb-.*\"} |= \"HTTP/\" != \"Gatus/1.0\" | pattern `<_> - <_> [<_>] \"<method> <path> <_>\" <status> <bytes> \"<referer>\" \"<ua>\" \"<xff>\"` | status=~\"[0-9]{3}\" | path=\"/config.json\" [$__range])) or vector(0)", "instant": true, "queryType": "instant"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}},
      "description": "The SPA fetches /config.json once per boot (NetworkFirst in the service worker) — best available proxy for app opens. Excludes Gatus."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests (excl. Gatus)",
